# Public domain for the site (required for real SSL certificates)
# A-record should point to 199.68.196.107
SITE_DOMAIN=loki-panel.shmoza.net

# Email for Let's Encrypt notifications
LETSENCRYPT_EMAIL=admin@example.com

# Host ports for nginx. For automatic SSL issuance, 80 and 443 should be reachable.
HTTP_PORT=80
HTTPS_PORT=443

# PDF render quality (higher = sharper + larger files)
PDF_RENDER_DPI=300
